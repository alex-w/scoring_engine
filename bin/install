#!/usr/bin/env python
"""Guided setup: write a ``.env`` for ``docker compose``.

Collects the handful of values ``docker-compose.yml`` interpolates and writes
them to ``.env``, generating strong secrets by default. This replaces the manual
``cp .env.example .env`` + hand-edit step.

It deliberately does NOT touch ``docker/engine.conf.inc``: that file is committed
and baked into the images at build time (``docker/base/Dockerfile`` copies it),
so an installer that rewrote or removed it would break every image build. The
Flask secret key is written to ``.env`` (``SCORINGENGINE_SECRET_KEY``), which the
web app reads in preference to engine.conf -- so a stable key is set without
editing the committed config.

Usage:
    bin/install                       # interactive prompts, generated defaults
    bin/install --non-interactive     # no prompts; generate secrets, accept defaults
    bin/install --force               # overwrite an existing .env
    bin/install --mysql-password ...  # supply a value instead of generating it
"""

import argparse
import os
import secrets
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ENV_PATH = os.path.join(REPO_ROOT, ".env")

# Image-version defaults mirror .env.example, the single source of truth for the
# stack. Kept in sync by hand -- there are only four and they change rarely.
IMAGE_DEFAULTS = {
    "PYTHON_VERSION": "3.14.3-slim-bookworm",
    "REDIS_VERSION": "7.0.4",
    "MARIADB_VERSION": "10",
    "NGINX_VERSION": "1.27.3-alpine3.20-slim",
}


def gen_password():
    """A strong, URL/.env/URI-safe password (token_urlsafe uses only [A-Za-z0-9_-])."""
    return secrets.token_urlsafe(24)


def gen_secret_key():
    """A 128-hex-char Flask session key, matching the .env.example guidance."""
    return secrets.token_hex(64)


def build_env(values):
    """Render the .env contents from a full values dict (deterministic order)."""
    lines = [
        "# Generated by bin/install. Safe to edit; re-run with --force to regenerate.",
        "",
        "# Docker image versions",
    ]
    for key in ("PYTHON_VERSION", "REDIS_VERSION", "MARIADB_VERSION", "NGINX_VERSION"):
        lines.append(f"{key}={values[key]}")
    lines += [
        "",
        "# Database credentials",
        f"MYSQL_ROOT_PASSWORD={values['MYSQL_ROOT_PASSWORD']}",
        f"MYSQL_PASSWORD={values['MYSQL_PASSWORD']}",
        "",
        "# Flask session signing key. Keep it stable and identical across web",
        "# replicas; changing it logs everyone out.",
        f"SCORINGENGINE_SECRET_KEY={values['SCORINGENGINE_SECRET_KEY']}",
        "",
    ]
    return "\n".join(lines)


def collect(args, interactive, prompt=input):
    """Assemble the values dict, prompting when interactive.

    Passwords and the secret key default to freshly generated values; an explicit
    ``--mysql-password`` (etc.) is used as the default instead. ``prompt`` is
    injectable so tests can drive the interactive path.
    """
    values = dict(IMAGE_DEFAULTS)
    root_pw = args.mysql_root_password or gen_password()
    app_pw = args.mysql_password or gen_password()
    secret = args.secret_key or gen_secret_key()

    if interactive:
        print("Configuring the Scoring Engine stack -> .env\n")
        for key in IMAGE_DEFAULTS:
            values[key] = prompt(f"{key} [{values[key]}]: ").strip() or values[key]
        root_pw = prompt("MySQL root password [generated]: ").strip() or root_pw
        app_pw = prompt("MySQL app password [generated]: ").strip() or app_pw
        secret = prompt("Flask secret key [generated]: ").strip() or secret

    values["MYSQL_ROOT_PASSWORD"] = root_pw
    values["MYSQL_PASSWORD"] = app_pw
    values["SCORINGENGINE_SECRET_KEY"] = secret
    return values


def main(argv=None):
    parser = argparse.ArgumentParser(description="Write a .env for docker compose (guided).")
    parser.add_argument("--non-interactive", action="store_true", help="Do not prompt; generate/accept defaults.")
    parser.add_argument("--force", action="store_true", help="Overwrite an existing .env.")
    parser.add_argument("--mysql-root-password", help="Use this instead of a generated one.")
    parser.add_argument("--mysql-password", help="Use this instead of a generated one.")
    parser.add_argument("--secret-key", help="Use this instead of a generated one.")
    parser.add_argument("--env-path", default=ENV_PATH, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    if os.path.exists(args.env_path) and not args.force:
        print(f"{args.env_path} already exists. Re-run with --force to overwrite.", file=sys.stderr)
        return 1

    interactive = not args.non_interactive and sys.stdin.isatty()
    values = collect(args, interactive)

    with open(args.env_path, "w") as fh:
        fh.write(build_env(values))

    print(f"Wrote {args.env_path}")
    print("docker/engine.conf.inc is unchanged (committed + baked into the images).")
    print("Next: docker compose up")
    return 0


if __name__ == "__main__":
    sys.exit(main())
